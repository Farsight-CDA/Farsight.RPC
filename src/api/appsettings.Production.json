{
  "Logging": {
    "Console": {
      "LogLevel": {
        "Default": "Information",
        "System.Net.Http": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Liquidatooor.Services.Liquidation.Execution": "Debug"
      }
    },
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "SecurityKeys": {
    "ServerDomain": "rpc.farsight-cda.de",
    "ServerName": "Farsight RPC",
    "Origins": [
      "https://rpc.farsight-cda.de"
    ],
    "ChallengeExpiryMinutes": 2
  },
  "ApiBinding": {
    "ListeningAddress": "0.0.0.0",
    "Port": 8080
  },
  "Jwt": {
    "Issuer": "Farsight.Rpc.Api",
    "Audience": "Farsight.Rpc.Web",
    "ExpiryMinutes": 480
  },
  "Instrumentation": {
    "EnableLogs": true,
    "EnableMetrics": true
  }
}
